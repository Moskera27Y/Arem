# AREM WORLD — Supabase environment variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env` / `.env.local` / real key values.
# Real values belong in Vercel → Project → Settings → Environment Variables.

# Supabase project API URL (e.g. https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key (client + browser). Protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key. SERVER-ONLY (route handlers). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
