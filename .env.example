# AREM WORLD — environment variable names (copy values into `.env.local` and
# Vercel → Project → Settings → Environment Variables). NEVER commit values.

# Neon Postgres connection (server-only; used by route handlers & DDL scripts)
DATABASE_URL=

# Vercel Blob read-write token (server-only) for Admin image uploads
BLOB_READ_WRITE_TOKEN=

# Admin bootstrap (used once to create the admin user; the password is hashed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret for signing session cookies (long random string, min 32 chars).
# Optional split secrets (recommended): ADMIN_SESSION_SECRET, CUSTOMER_SESSION_SECRET
SESSION_SECRET=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=

# Public site URL (used for reset links, Square redirect, OG/canonical)
NEXT_PUBLIC_SITE_URL=https://arem-mu.vercel.app

# Square payments (server-only; NEVER expose to the client)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox   # or "production"
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shipping provider (server-only). US domestic fulfillment:
# SHIPPING_PROVIDER=mock (dev, no credentials) | easypost (USPS/UPS/FedEx/DHL) | generic (HTTP carrier API)
SHIPPING_PROVIDER=mock
# EasyPost: base https://api.easypost.com/v2, key EZTK… (test) or live key (prod)
SHIPPING_API_URL=https://api.easypost.com/v2
SHIPPING_API_KEY=
# Generic HTTP carrier (only when SHIPPING_PROVIDER=generic)
# SHIPPING_API_URL=https://carrier.example.com
SHIPPING_ORIGIN_NAME=AREM WORLD
SHIPPING_ORIGIN_COUNTRY=US
SHIPPING_ORIGIN_CITY=
SHIPPING_ORIGIN_STATE=
SHIPPING_ORIGIN_ADDRESS=
SHIPPING_ORIGIN_POSTAL=
SHIPPING_ORIGIN_PHONE=
SHIPPING_DEFAULT_WEIGHT_KG=1
SHIPPING_DIM_LENGTH_IN=12
SHIPPING_DIM_WIDTH_IN=9
SHIPPING_DIM_HEIGHT_IN=6
SHIPPING_WEBHOOK_SECRET=

# Email (server-only). Resend recommended; else logs to console in dev.
RESEND_API_KEY=
EMAIL_FROM=AREM WORLD <hola@arem.world>
